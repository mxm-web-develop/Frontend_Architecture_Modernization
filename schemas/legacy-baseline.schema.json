    "domain",
    "legacy_repository",
    "baseline_commit"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "legacy_repository": {
      "type": "string"
    },
    "baseline_commit": {
      "type": "string"
