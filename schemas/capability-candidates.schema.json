{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Candidates",
  "type": "object",
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CAP-CAND-[A-Z0-9-]+$|^CAP-CAND-[0-9]+$"
          },
          "inferred_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "NEEDS_SEMANTIC_REVIEW",
              "CONFIRMED",
              "REJECTED"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "number"
            ]
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    }
  }
}
