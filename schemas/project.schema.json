{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modernization Project",
  "type": "object",
  "required": [
    "schema_version",
    "repositories",
    "language",
    "modernization"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "repositories": {
      "type": "object",
      "required": [
        "sources",
        "target"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "read-only",
                  "read-write"
                ]
              },
              "baseline_commit": {
                "type": "string"
              }
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "id",
            "path",
            "mode"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "read-write"
              ]
            }
          }
        }
      }
    },
    "migration_mode": {
      "enum": [
        "cross-repository",
        "in-place"
      ]
    },
    "language": {
      "type": "object",
      "required": [
        "human_documentation",
        "enforce_human_documentation"
      ],
      "properties": {
        "interaction": {
          "type": "string",
          "minLength": 2
        },
        "human_documentation": {
          "type": "string",
          "minLength": 2
        },
        "enforce_human_documentation": {
          "type": "boolean"
        },
        "machine_protocol": {
          "type": "string"
        },
        "code_identifiers": {
          "type": "string"
        },
        "code_comments": {
          "type": "string"
        },
        "governed_markdown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modernization": {
      "type": "object",
      "properties": {
        "scope_mode": {
          "const": "brownfield-new-repository"
        },
        "new_requirements": {
          "enum": [
            "defer",
            "reject"
          ]
        },
        "framework_strategy": {
          "enum": [
            "undecided-until-confirmed"
          ]
        }
      }
    }
  }
}
