{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Functional Scenarios",
  "type": "object",
  "required": ["schema_version", "domain", "scenarios"],
  "properties": {
    "schema_version": {"type": "string"},
    "domain": {"type": "string"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capability", "status"],
        "properties": {
          "id": {"type": "string"},
          "capability": {"type": "string"},
          "status": {"enum": ["PENDING", "PASS", "FAIL", "WAIVED"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
