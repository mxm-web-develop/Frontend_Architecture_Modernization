{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parity Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "capabilities"
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "WAIVED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "functional",
          "visual",
          "architecture",
          "traceability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "functional": {
            "$ref": "#/$defs/gate"
          },
          "visual": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "policy": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PENDING",
                  "PASS",
                  "FAIL",
                  "WAIVED",
                  "NOT_APPLICABLE"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "architecture": {
            "$ref": "#/$defs/gate"
          },
          "traceability": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    }
  }
}
