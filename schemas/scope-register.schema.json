{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Modernization Scope Register",
  "type":"object",
  "required":["schema_version","items"],
  "properties":{
    "schema_version":{"type":"string"},
    "items":{"type":"array","items":{"type":"object","required":["id","type","title","status"],"properties":{
      "id":{"type":"string"},
      "type":{"enum":["LEGACY_PARITY","LEGACY_DELTA","ARCHITECTURE_REMEDIATION","GOVERNANCE_ENABLEMENT","NEW_REQUIREMENT"]},
      "title":{"type":"string"},
      "status":{"enum":["ACTIVE","DEFERRED","DONE","WAIVED"]},
      "source":{"type":["string","null"]},"notes":{"type":"array","items":{"type":"string"}}
    }}}
  }
}
