{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "apis"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
