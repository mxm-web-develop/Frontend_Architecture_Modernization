{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Evidence Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "environment",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "policy",
          "status",
          "baseline_source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "policy": {
            "enum": [
              "STRICT_PRESERVE",
              "STRUCTURE_PRESERVE",
              "APPROVED_REDESIGN",
              "NOT_VISUAL"
            ]
          },
          "legacy_commit": {
            "type": "string"
          },
          "fixture": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseline": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "PASS",
              "FAIL",
              "WAIVED",
              "NOT_APPLICABLE"
            ]
          },
          "baseline_source": {
            "enum": [
              "live_runtime",
              "legacy_build"
            ],
            "description": "v1.6 P6: STRICT_PRESERVE 必须为 live_runtime；legacy_build 仅在 profile.live_runtime.required=false 且 live_runtime.url 为空时合法"
          },
          "live_runtime": {
            "type": "object",
            "description": "v1.6 P6: STRICT_PRESERVE 必须配套 live runtime evidence 字段",
            "required": [
              "url",
              "captured_at",
              "commit",
              "screenshot_sha256"
            ],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "captured_at": { "type": "string" },
              "commit": { "type": "string" },
              "screenshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "scenario_id": { "type": "string" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "policy": { "const": "STRICT_PRESERVE" } },
              "required": ["policy"]
            },
            "then": {
              "properties": {
                "baseline_source": { "const": "live_runtime" }
              },
              "required": ["live_runtime"]
            }
          }
        ]
      }
    }
  }
}
