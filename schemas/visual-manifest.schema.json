{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Evidence Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "environment",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "policy",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "policy": {
            "enum": [
              "STRICT_PRESERVE",
              "STRUCTURE_PRESERVE",
              "APPROVED_REDESIGN",
              "NOT_VISUAL"
            ]
          },
          "legacy_commit": {
            "type": "string"
          },
          "fixture": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseline": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "PASS",
              "FAIL",
              "WAIVED",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    }
  }
}
