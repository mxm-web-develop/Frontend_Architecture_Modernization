{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Command Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "domain",
    "gate",
    "command",
    "status",
    "exit_code",
    "started_at",
    "ended_at",
    "commit"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "const": "command-run"
    },
    "domain": {
      "type": "string"
    },
    "gate": {
      "enum": [
        "functional",
        "architecture",
        "traceability"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "command_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
