{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Command Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_type",
    "domain",
    "gate",
    "command",
    "status",
    "exit_code",
    "started_at",
    "ended_at",
    "commit"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "evidence_type": {
      "const": "command-run"
    },
    "domain": {
      "type": "string"
    },
    "gate": {
      "enum": [
        "functional",
        "architecture",
        "traceability"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "command_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "oneOf": [
    {
      "title": "command-run",
      "type": "object",
      "required": ["evidence_type"],
      "properties": {
        "evidence_type": { "const": "command-run" }
      }
    },
    {
      "title": "live-runtime-snapshot",
      "type": "object",
      "required": [
        "evidence_type",
        "url",
        "screenshot_sha256",
        "dom_snapshot_path",
        "captured_at",
        "commit"
      ],
      "properties": {
        "evidence_type": { "const": "live-runtime-snapshot" },
        "url": { "type": "string", "format": "uri" },
        "screenshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dom_snapshot_path": { "type": "string" },
        "captured_at": { "type": "string" },
        "commit": { "type": "string" },
        "scenario_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "viewport": { "type": "object" }
      }
    },
    {
      "title": "live-runtime-flow",
      "type": "object",
      "required": [
        "evidence_type",
        "url",
        "steps",
        "captured_at",
        "commit"
      ],
      "properties": {
        "evidence_type": { "const": "live-runtime-flow" },
        "url": { "type": "string", "format": "uri" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "action",
              "screenshot_sha256",
              "dom_snapshot_path",
              "captured_at"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": ["navigate", "click", "type", "select", "route", "wait"]
              },
              "selector": { "type": "string" },
              "value": { "type": "string" },
              "screenshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "dom_snapshot_path": { "type": "string" },
              "captured_at": { "type": "string" }
            }
          }
        },
        "captured_at": { "type": "string" },
        "commit": { "type": "string" },
        "capability_id": { "type": "string" }
      }
    }
  ]
}
